DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
ADMIN_PASSCODE=choose-a-long-private-passcode
SESSION_SECRET=choose-a-random-secret-at-least-32-characters
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
# Optional social sign-in. Register each HTTPS callback URL with the provider.
# Telegram uses BotFather Login Widget Client ID/Secret (not the bot API token).
# TikTok uses Login Kit Client Key/Secret.
TELEGRAM_CLIENT_ID=
TELEGRAM_CLIENT_SECRET=
TELEGRAM_REDIRECT_URI=https://your-domain.example/api/customer/oauth/telegram/callback
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=https://your-domain.example/api/customer/oauth/tiktok/callback
